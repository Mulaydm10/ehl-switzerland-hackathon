# Names only. Never commit values; the real file is .env, which is gitignored.

# Hedera account the paid routes are quoted to (the seller). Required.
SURFACE_PAYEE_ACCOUNT_ID=

# CAIP-2 network the quotes name, e.g. hedera:testnet. Testnet only.
SURFACE_NETWORK=

# Port the resource server listens on. Optional.
SURFACE_PORT=

# Facilitator that verifies and settles payments, e.g. the Blocky402 testnet URL.
BLOCKY402_FACILITATOR_URL=
