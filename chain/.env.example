# chain/ lane — copy to .env and fill in. NEVER commit .env or any real value.
# Testnet only. A leaked testnet key is still a leaked key, and this repo goes public.

# Hedera testnet payer account, e.g. 0.0.12345
HEDERA_ACCOUNT_ID=

# Payer private key (ECDSA or ED25519, DER or hex). Testnet only.
HEDERA_PRIVATE_KEY=

# An x402-gated URL settled by the Blocky402 facilitator on hedera:testnet.
X402_RESOURCE_URL=

# Blocky402 facilitator base URL (no trailing slash). Used for GET /supported.
BLOCKY402_FACILITATOR_URL=
