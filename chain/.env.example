# chain/ lane — copy to chain/.env and fill in. NEVER commit .env or any real value.
# chain/src/env.ts loads chain/.env for `npm run pay:once` and the live tests;
# variables already set in the shell always win, so CI is unaffected.
# Testnet only. A leaked testnet key is still a leaked key, and this repo goes public.

# Hedera testnet payer account, e.g. 0.0.12345
HEDERA_ACCOUNT_ID=

# Payer private key (ECDSA or ED25519, DER or hex). Testnet only.
HEDERA_PRIVATE_KEY=

# Blocky402 facilitator base URL (no trailing slash), e.g. https://api.testnet.blocky402.com
BLOCKY402_FACILITATOR_URL=

# Payee for the direct-settlement path — a second testnet account, never the payer.
HEDERA_PAYEE_ACCOUNT_ID=

# Amount in tinybars for the direct-settlement path. Default 100000 (0.001 HBAR).
HEDERA_AMOUNT_TINYBAR=

# Optional: an x402-gated URL to pay instead of settling directly. Not required
# for real settlement evidence.
X402_RESOURCE_URL=
